# Trenches - configuracion privada local (excluida de Git).
# Pega SOLO tu API key de Helius despues del signo = y guarda el archivo.
HELIUS_API_KEY=

# Si prefieres usar la URL RPC completa, rellena esta variable en su lugar:
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=TU_CLAVE

# ── 📡 Señales TG (scraping read-only del canal VIP) ──
# Token del bot de Telegram (BotFather) que lee el canal. SIN ESTO la pestaña
# Señales TG responde 503 honesto: nunca se inventan llamadas.
TG_BOT_TOKEN=

# Chat a scrapear: supergrupo/canal privado (id negativo, p.ej. -1003686690861).
# El bot debe ser miembro del chat. Con t.me/c/3686690861/... el chat es -1003686690861.
TG_CHAT_ID=-1003686690861

# Opcional: topic de un supergrupo con temas (t.me/c/<chat>/<topic>/...).
# 0 o vacío = recolectar TODO el chat.
TG_TOPIC_ID=8469

# ── 🔐 Gate de acceso a Señales TG (códigos 24h del bot) ──
# Firma los pases x-tg-pass del gate. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TG_GATE_SECRET=

# (El endpoint público /api/tokens/:chain/:address/onchain-activity comparte
# este gate:wallet intel es valor Elite.)

# Secreto admin compartido: el bot saur-bot lo usa para mintear códigos
# (/code) vía POST /api/admin/tg/mint-code. Debe ser EL MISMO valor en la
# API (Fly secret) y en saur-bot/.env.
ADMIN_SECRET=

# ── 🧠 Wallet Ingestion (Position Engine V2) ──
# Reutiliza HELIUS_API_KEY de arriba: con ella, el server sondea wallets
# trackeadas (POST /api/admin/wallets con ADMIN_SECRET) y guarda sus swaps
# on-chain (overlay de smart money/dev en el terminal). Sin API key el loop
# no arranca y el endpoint responde 503 honesto. Presupuesto: 100 créditos
# por poll (plan gratis 1M/mes → ~10k polls); el poller gasta top-down por
# prioridad, máx 20 polls/min. Pon "off" para desactivar el loop aunque haya key.
# WALLET_ACTIVITY=off

# 👛 Wallets de plataforma: TRENCHES genera una direccion por red al loguearse
# (sin conectar wallet externa). Este secreto cifra las claves en la DB.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENC_SECRET=

# 🔐 Login con Google (OAuth 2.0 Client ID de https://console.cloud.google.com/apis/credentials,
# originales autorizados: https://inusaur.online y http://localhost:8931)
GOOGLE_CLIENT_ID=
