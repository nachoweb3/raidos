# 🧠 Community Brain — Telegram bot

# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Your Telegram user id (bot operator; can always run admin commands)
OWNER_ID=123456789

# Optional: restrict the bot to a single group chat id (recommended for private bots)
# GROUP_ID=-1001234567890

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text

# 🤖 AI backend — "local" (Ollama, default) or "cloud" (OpenAI-compatible API)
# AI_MODE=cloud
# OPENAI_BASE_URL=https://api.openai.com/v1   # or Groq: https://api.groq.com/openai/v1 · OpenRouter: https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-...
# Cloud mode requires explicit models, e.g.:
# CHAT_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small
#
# After switching AI backends, run /reembed in each chat to rebuild KB vectors.

# SQLite database path
DB_PATH=./brain.db

# 📊 Market data provider (used by /volume set <address> [symbol] [provider])
# dexscreener  — keyless, all major chains (default)
# geckoterminal — keyless, 200+ networks; set the network id below
# birdeye      — richest data (holders), needs an API key from birdeye.so
# GECKO_NETWORK=solana      # geckoterminal network id: solana, eth, base, bsc, avax…
# BIRDEYE_API_KEY=...
# BIRDEYE_CHAIN=solana      # x-chain header sent to birdeye
